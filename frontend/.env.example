# Frontend data source. One switch, no code changes.
#
#   NEXT_PUBLIC_USE_MOCK=true   -> built-in mock backend (sample data, runs with no server)
#   NEXT_PUBLIC_USE_MOCK=false  -> live Greenlight API at NEXT_PUBLIC_API_URL
#
# Do not add /api/v1 to the URL. See CONNECT_BACKEND.md.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:8000
