# Which backend does this deployment offer?
#
#   NEXT_PUBLIC_USE_MOCK=false + NEXT_PUBLIC_API_URL=<backend>
#       -> the login page offers a real sign-in (registered email and password)
#          AND the built-in demo. The visitor chooses.
#   NEXT_PUBLIC_USE_MOCK=true (or no API URL)
#       -> demo only: built-in sample data, no server needed.
#
# Do not add /api/v1 to the URL. It must be https:// in production. See CONNECT_BACKEND.md.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:8000
