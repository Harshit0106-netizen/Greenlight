DATABASE_URL=postgresql://user:password@localhost:5432/greenlight
JWT_SECRET=change-me
ANTHROPIC_API_KEY=your-key-here
ALLOWED_ORIGIN=http://localhost:3000
# Optional (defaults shown)
# APP_ENV=dev                      # set to "production" to refuse the default JWT secret
# ANTHROPIC_MODEL=claude-sonnet-5-5
# EMBEDDING_MODEL=all-MiniLM-L6-v2 # falls back to a built-in hashing embedder if unavailable
# SEED_PASSWORD=greenlight-demo    # password for demo users created by `python -m app.seed`
